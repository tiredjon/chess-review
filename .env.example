# Скопируй в .env и заполни. .env в git не попадает.

APP_ENV=dev
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console
CORS_ORIGINS=["http://localhost:3000"]

# Порты на хосте (docker compose). Внутри сети контейнеры ходят по стандартным портам.
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Для запуска backend локально (вне Docker). В compose эти URL переопределяются.
DATABASE_URL=postgresql+asyncpg://chess:chess@localhost:5432/chess_review
REDIS_URL=redis://localhost:6379/0
TEST_DATABASE_URL=postgresql+asyncpg://chess:chess@localhost:5432/chess_review_test
TEST_REDIS_URL=redis://localhost:6379/15

# Dev-пользователь из начальной миграции. Первый зарегистрированный получает эту запись
# вместе с её партиями, анализами и пазлами (AUTH_CLAIM_DEV_USER=false — отключить).
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_EMAIL=dev@localhost
AUTH_CLAIM_DEV_USER=true

# Auth. JWT_SECRET обязателен при APP_ENV=prod (сгенерировать: openssl rand -base64 32);
# без него в dev ключ случайный на каждый запуск API (сессии продлеваются refresh-токеном).
JWT_SECRET=
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_DAYS=30
# Cookie refresh-токена: COOKIE_SECURE=true за HTTPS; SameSite=none — если web и API
# на разных сайтах (тогда нужен и COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Лимиты «N/период» (s, m, h, d; например 30/hour, 5/30s). Импорт, анализ, LLM — на
# пользователя (LLM не считается при LLM_PROVIDER=none), вход и регистрация — на IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IMPORT=30/hour
RATE_LIMIT_ANALYZE=100/hour
RATE_LIMIT_LLM=300/hour
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=10/hour
# Сохранение анализа из браузера и оценка позиций движком API (режим исследования) —
# на пользователя; разборов из Telegram-бота — на чат.
RATE_LIMIT_BROWSER=300/hour
RATE_LIMIT_EXPLORE=600/hour
RATE_LIMIT_BOT=20/hour
# IP клиента из X-Forwarded-For — только за своим reverse proxy.
TRUST_FORWARDED_FOR=false

# Движок
STOCKFISH_PATH=stockfish
ENGINE_POOL_SIZE=4
ENGINE_THREADS=1
ENGINE_HASH_MB=128
ENGINE_TIMEOUT_S=60
ANALYSIS_DEPTH=18
ANALYSIS_MULTIPV=3
# Режим исследования через API: глубина и процессы Stockfish в самом API (стартуют при
# первом запросе). Анализ из браузера мельче BROWSER_MIN_DEPTH не сохраняется.
EXPLORE_DEPTH=18
EXPLORE_POOL_SIZE=1
BROWSER_MIN_DEPTH=10
# Воркер: партий одновременно и таймаут анализа одной партии.
WORKER_MAX_JOBS=2
ANALYSIS_JOB_TIMEOUT_S=1800

# Импорт Lichess / Chess.com. User-Agent обязателен: на дефолтный Lichess отвечает 404.
IMPORT_USER_AGENT=ChessReview/0.1 (self-hosted game review)
# Необязательный personal access token Lichess (без scope): быстрее выгрузка партий.
LICHESS_TOKEN=
IMPORT_JOB_TIMEOUT_S=1800

# LLM: none | gemini | openai | anthropic. При none объяснения строятся по шаблонам.
LLM_PROVIDER=none
# Пусто — модель по умолчанию: gemini-3.1-flash-lite / gpt-5-nano / claude-haiku-5-5.
LLM_MODEL=
LLM_TIMEOUT_S=30
# Одновременных запросов к LLM при пакетном объяснении ходов.
LLM_MAX_CONCURRENCY=4
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram-бот (`make bot`): токен — у @BotFather. Без токена бот не запускается.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
# Адрес веб-приложения для ссылок на разбор (`/share/{token}`) — публичный, иначе
# ссылки из Telegram откроются только на этой машине.
PUBLIC_WEB_URL=http://localhost:3000
# Разборов одновременно и сколько ждать анализа партии (дальше — ответ ссылкой).
BOT_MAX_CONCURRENCY=4
BOT_ANALYSIS_TIMEOUT_S=600
